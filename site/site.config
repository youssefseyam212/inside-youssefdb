# Settings for site/build.sh. A SITE_URL set in the environment overrides this file.
#
# SITE_URL is the public address of the site, with no trailing slash, for example
#   SITE_URL=https://inside.youssefdb.dev
# It is used for the canonical link, Open Graph tags, robots.txt and sitemap.xml.
# Leave it empty until you have a domain: the build then skips the tags that need a full URL.
SITE_URL=
